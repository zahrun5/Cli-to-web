# Agent Configuration

# Relay server URL (use wss:// in production!)
RELAY_URL=wss://terminal.yourdomain.com/ws/agent

# Agent token — get this from the relay server admin panel
# or generate with: curl https://terminal.yourdomain.com/api/generate-token?name=myserver
AGENT_TOKEN=your-agent-id:your-hmac-signature

# Shell to spawn (default: user's shell or /bin/bash)
SHELL=/bin/bash
