# Relay Server Configuration

# Secret key for signing/verifying agent tokens
RELAY_SECRET=change-me-to-a-long-random-string

# Web UI login credentials (username:bcrypt_hash)
# Generate hash: node -e "require('bcryptjs').hash('yourpassword',10).then(h=>console.log(h))"
WEB_USER=admin
WEB_PASS_HASH=$2a$10$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Server port (Nginx/Caddy will reverse-proxy to this)
PORT=3100

# Session secret for login cookies
SESSION_SECRET=another-random-string-here
