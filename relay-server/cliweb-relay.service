[Unit]
Description=CLI-to-Web Relay Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=harun
ExecStart=/usr/bin/node /home/harun/cli-to-web/relay-server/src/server.js
WorkingDirectory=/home/harun/cli-to-web/relay-server
EnvironmentFile=/home/harun/cli-to-web/relay-server/.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
